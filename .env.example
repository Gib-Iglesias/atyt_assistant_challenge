# Copiar a .env: cp .env.example .env
# Estos valores arrancan el proyecto tal cual, sin red y sin API key.

# ---------------------------------------------------------------- base de datos
# Motor por defecto SQLite, en el volumen compartido entre django y api.
# Migrar a Postgres es cambiar solo esta linea:
#   DATABASE_URL=postgresql://user:pass@host:5432/atyt
DATABASE_URL=sqlite:////data/db.sqlite3

# ---------------------------------------------------------------- secretos
# Valores de desarrollo. En cualquier entorno real se generan y no se versionan.
DJANGO_SECRET_KEY=dev-only-cambiar-en-produccion
JWT_SECRET=dev-only-cambiar-en-produccion
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60

# ---------------------------------------------------------------- django
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django,web
DJANGO_LANGUAGE_CODE=es
DJANGO_TIME_ZONE=UTC

# ---------------------------------------------------------------- proveedor de LLM
# fake     -> implementacion falsa, emite token a token, sin red ni credenciales
# openai | anthropic | gemini | ollama -> proveedores reales
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Limite global de la cuenta, no por usuario. Ver docs/ARQUITECTURA.md, seccion 5.
LLM_MAX_CONCURRENCY=20
LLM_MAX_CONTEXT_TOKENS=6000
LLM_TIMEOUT_SECONDS=60
LLM_QUEUE_MAX_SIZE=200
LLM_QUEUE_TIMEOUT_SECONDS=30

# Retardo simulado entre tokens del proveedor falso, para ver el streaming.
FAKE_LLM_TOKEN_DELAY_MS=25

# ---------------------------------------------------------------- recuperacion
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=1.5    # BM25 invertido; por debajo de ~1.5 se escala
CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=150

# ---------------------------------------------------------------- datos de ejemplo
# full -> 122 documentos, incluido el de 400 paginas que pide el enunciado (~18 s)
# fast -> mismos 40 tenants y ~4.000 pedidos, documentos cortos (~7 s)
SEED_PROFILE=full
SEED_TENANTS=40
SEED_RANDOM_SEED=20260724

# ---------------------------------------------------------------- limites de la api
RATE_LIMIT_PER_MINUTE=60
